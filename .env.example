# PostgreSQL (local Postgres, Docker, or a Supabase Postgres connection string)
# Owner connection: used ONLY by migrations and seed scripts.
DATABASE_ADMIN_URL=postgres://rii:rii@localhost:5432/rii
# Application connection: non-owner role `rii_app` (created by migration 003) so Row-Level Security applies.
DATABASE_URL=postgres://rii_app:rii_app@localhost:5432/rii
# Databases used by automated tests (they are wiped by the test suite!)
TEST_DATABASE_ADMIN_URL=postgres://rii:rii@localhost:5432/rii_test
TEST_DATABASE_URL=postgres://rii_app:rii_app@localhost:5432/rii_test
# Public base URL used in emails (password reset / invitations) and QR codes
APP_URL=http://localhost:3000
# Secret used to sign/hash session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Where uploaded media files are stored (local disk adapter)
UPLOAD_DIR=./storage/uploads
# Show the demo-account picker on the login page (set to false in production)
SHOW_DEMO_ACCOUNTS=true
# Email: this build does NOT send email. All notifications (invites, password resets, approvals) are
# written to the in-app Email Outbox (Admin → Settings → Outbox). SMTP_URL is reserved for a future adapter.
SMTP_URL=
# Only for `npm run db:bootstrap` (production install without demo data)
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
# E2E tests target this URL (default http://localhost:3000)
# E2E_BASE_URL=
