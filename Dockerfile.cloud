# Single-container image for PaaS hosts (Railway etc.): migrates, seeds demo data on an
# empty database, rotates the rii_app password, then runs Next.js. See scripts/cloud-start.ts.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build
ENV NODE_ENV=production UPLOAD_DIR=/data/uploads
RUN mkdir -p /data/uploads
EXPOSE 3000
CMD ["npx", "tsx", "scripts/cloud-start.ts"]
